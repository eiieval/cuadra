GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live
# Cuadra's own plans (npm run paypal:setup prints them)
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_TEAM=
# Webhook id printed by `npm run paypal:setup -- --webhook-url https://your-host/api/paypal-webhook` (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
# Ed25519 key that signs attestations of issued records (npm run attest:keygen shows how to make one). Empty: attestation off.
ATTEST_PRIVATE_KEY=
# Base URL for PayPal return links, e.g. https://cuadra.example.com (default: the request host)
PUBLIC_URL=
# MCP server: your company and ledger file (default ~/.cuadra/ledger.json)
CUADRA_NAME=
CUADRA_NIF=
CUADRA_SERIES=
CUADRA_LEDGER=
