  {
   "label": "And that the hash chain of the ledger still verifies",
   "lines": [
    {
     "dir": "out",
     "msg": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tools/call",
      "params": {
       "name": "verify_ledger",
       "arguments": {}
      }
     }
    },
    {
     "dir": "in",
     "msg": {
      "jsonrpc": "2.0",
      "id": 6,
      "result": {
       "content": [
        {
         "type": "text",
         "text": "{\n  \"ok\": true,\n  \"records\": 1,\n  \"lastHash\": \"98E98148C92396F7AB935A631D23B604E7D780ABCDF05500AA62CDDB6B5CA245\",\n  \"file\": \"ledger.json\"\n}"
